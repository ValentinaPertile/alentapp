{
  "dashboard": {
    "id": null,
    "title": "RED — Alentapp API",
    "description": "Dashboard de observabilidad con métricas corregidas Rate, Errors y Duration",
    "tags": ["alentapp", "red-method", "observabilidad"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Requests por segundo (Rate)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Tasa de error (%)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Latencia Percentil 95 (p95)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_bucket[5m])) by (le))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Latencia Percentil 99 (p99)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_bucket[5m])) by (le))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Distribución por Status Code",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 30,
              "stacking": { "mode": "normal", "group": "A" }
            }
          }
        },
        "targets": [
          {
            "expr": "sum by (status) (rate(http_requests_total[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Endpoints más lentos (Top 5)",
        "type": "barchart",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "topk(5, sum by (route) (rate(http_request_duration_sum[5m]) / rate(http_request_duration_count[5m])))",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
