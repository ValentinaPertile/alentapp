{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "ignoreDeprecations": "6.0",
      "rootDir": ".",
      "baseUrl": ".",
      "paths": {
        "@alentapp/shared": ["packages/shared/src/index.ts"]
      }
    },
    "include": ["packages/**/*"]
  }